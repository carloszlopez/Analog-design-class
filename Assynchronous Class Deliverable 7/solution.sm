    </region>
    <region left="396" top="1710" width="206" height="24" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">TJ</e>
          <e type="operand">Tamb</e>
          <e type="operand">ΔT</e>
          <e type="operator" args="2">+</e>
          <e type="operator" args="2">:</e>
        </input>
        <contract>
          <e type="operand" style="unit">°C</e>
        </contract>
        <result action="numeric">
          <e type="operand">141.616</e>
