  <regions type="content">
    <region left="0" top="0" width="773" height="38" color="#000000" fontSize="10">
      <text lang="eng" width="773" fontFamily="Arial" fontSize="10">
        <content>
          <p>Recalculate the parallel LC network originally used around 2.4 GHz to operate at 850 MHz, in order to find a commercial part number for C19 and L5, taking into account that the values must change according to the following requirements:</p>
        </content>
      </text>
    </region>
    <region left="0" top="36" width="772" height="301" color="#000000">
      <picture>
        <raw format="png" encoding="base64"></raw>
      </picture>
    </region>
    <region left="0" top="342" width="90" height="24" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">F</e>
          <e type="operand">850</e>
          <e type="operand" style="unit">MHz</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="108" top="342" width="155" height="23" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-style: italic;">* Transmition frequency</p>
        </content>
      </text>
    </region>
    <region left="0" top="360" width="98" height="24" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">BW</e>
          <e type="operand">200</e>
          <e type="operand" style="unit">MHz</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="108" top="360" width="152" height="23" color="#000000" fontSize="10" isBreakable="false">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-style: italic;">* Bandwidth (-/+100Hz)</p>
        </content>
      </text>
    </region>
    <region left="0" top="378" width="90" height="24" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">RF</e>
          <e type="operand">50</e>
          <e type="operand" style="unit">ohm</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="108" top="378" width="186" height="23" color="#000000" fontSize="10" isBreakable="false">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-style: italic;">* Transmition line impedance</p>
        </content>
      </text>
    </region>
    <region left="0" top="396" width="90" height="24" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">Z1</e>
          <e type="operand">50</e>
          <e type="operand" style="unit">ohm</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="108" top="396" width="172" height="23" color="#000000" fontSize="10" isBreakable="false">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-style: italic;">* Power supply impedance</p>
        </content>
      </text>
    </region>
    <region left="0" top="414" width="101" height="29" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">P.max</e>
          <e type="operand">1</e>
          <e type="operand" style="unit">watt</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="108" top="414" width="121" height="23" color="#000000" fontSize="10" isBreakable="false">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-style: italic;">* Maximum power</p>
        </content>
      </text>
    </region>
    <region left="0" top="432" width="85" height="29" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">V.max</e>
          <e type="operand">20</e>
          <e type="operand" style="unit">V</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="108" top="432" width="295" height="23" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p>* Maximum transmission voltage (peak to peak)</p>
        </content>
      </text>
    </region>
    <region left="0" top="450" width="74" height="24" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">T</e>
          <e type="operand">25</e>
          <e type="operand" style="unit">°C</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="108" top="450" width="207" height="23" color="#000000" fontSize="10" isBreakable="false">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p>* Nominal operation temperature</p>
        </content>
      </text>
    </region>
    <region left="0" top="477" width="774" height="23" color="#000000" bgColor="#ffff00" fontSize="10" isBreakable="false">
      <text lang="eng" width="774" fontFamily="Arial" fontSize="10">
        <content>
          <p style="background-color: #ffff00;">* Resonance frequency</p>
        </content>
      </text>
    </region>
    <region left="0" top="495" width="219" height="41" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">ω.0</e>
          <e type="operand">2</e>
          <e type="operand">π</e>
          <e type="operator" args="2">*</e>
          <e type="operand">F</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
        <contract>
          <e type="operand" style="unit">rad</e>
          <e type="operand" style="unit">sec</e>
          <e type="operator" args="2">/</e>
        </contract>
        <result action="numeric">
          <e type="operand">5.3407</e>
          <e type="operand">10</e>
          <e type="operand">9</e>
          <e type="operator" args="2">^</e>
          <e type="operator" args="2">*</e>
        </result>
      </math>
    </region>
    <region left="0" top="531" width="774" height="23" color="#000000" bgColor="#ffff00" fontSize="10" isBreakable="false">
      <text lang="eng" width="774" fontFamily="Arial" fontSize="10">
        <content>
          <p style="background-color: #ffff00;">* Q factor for given bandwith</p>
        </content>
      </text>
    </region>
    <region left="0" top="549" width="108" height="41" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">Q</e>
          <e type="operand">F</e>
          <e type="operand">BW</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">4.25</e>
        </result>
      </math>
    </region>
    <region left="0" top="585" width="774" height="23" color="#000000" bgColor="#ffff00" fontSize="10" isBreakable="false">
      <text lang="eng" width="774" fontFamily="Arial" fontSize="10">
        <content>
          <p style="background-color: #ffff00;">* Impedance</p>
        </content>
      </text>
    </region>
    <region left="0" top="612" width="153" height="58" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">R.p</e>
          <e type="operand">1</e>
          <e type="operand">1</e>
          <e type="operand">Z1</e>
          <e type="operator" args="2">/</e>
          <e type="operand">1</e>
          <e type="operand">RF</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">+</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">25</e>
          <e type="operand" style="unit">Ω</e>
          <e type="operator" args="2">*</e>
        </result>
      </math>
    </region>
    <region left="0" top="675" width="774" height="23" color="#000000" bgColor="#ffff00" fontSize="10" isBreakable="false">
      <text lang="eng" width="774" fontFamily="Arial" fontSize="10">
        <content>
          <p style="background-color: #ffff00;">* Inductance and capacitance for given Q and RP</p>
        </content>
      </text>
    </region>
    <region left="0" top="702" width="83" height="51" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">Q.L</e>
          <e type="operand">R.p</e>
          <e type="operand">ω.0</e>
          <e type="operand">L</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">:</e>
