  <regions type="content">
    <region left="0" top="0" width="762" height="68" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p>
            <span style="font-weight: bold;">According to Micron application note TN-00-06. Solve the amount of decoupling capacitors required for a ficticious IC DRAM memory:</span>
            <br />VDD = 3.3V + 0.3V/-0.165V<br />Temp. Range: 0 – 50°C</p>
        </content>
      </text>
    </region>
    <region left="0" top="63" width="772" height="23" color="#000000" bgColor="#ffff80" fontSize="10">
      <text lang="eng" width="772" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-style: normal; background-color: #ffff80;">Currents for each output and n simultaneously outputs:</p>
        </content>
      </text>
    </region>
    <region left="0" top="81" width="74" height="24" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">C</e>
          <e type="operand">25</e>
          <e type="operand" style="unit">pF</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="90" top="81" width="124" height="23" color="#808080" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="color: #808080; font-style: italic;">*Load capacitance</p>
        </content>
      </text>
    </region>
    <region left="0" top="99" width="82" height="24" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">dV</e>
          <e type="operand">3.3</e>
          <e type="operand" style="unit">V</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="90" top="99" width="216" height="23" color="#808080" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-style: italic; color: #808080;">*Absolute voltage range to drive C</p>
        </content>
      </text>
    </region>
    <region left="0" top="117" width="74" height="24" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">dt</e>
          <e type="operand">1</e>
          <e type="operand" style="unit">ns</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="90" top="117" width="121" height="23" color="#808080" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-style: italic; color: #808080;">*Time to reach dV</p>
        </content>
      </text>
    </region>
    <region left="0" top="135" width="155" height="41" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">I</e>
          <e type="operand">C</e>
          <e type="operand">dV</e>
          <e type="operator" args="2">*</e>
          <e type="operand">dt</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">:</e>
        </input>
        <contract>
          <e type="operand" style="unit">A</e>
        </contract>
        <result action="numeric">
          <e type="operand">0.0825</e>
        </result>
      </math>
    </region>
    <region left="0" top="171" width="54" height="24" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">n</e>
          <e type="operand">64</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
