    </region>
    <region left="0" top="639" width="772" height="79" color="#000000">
      <picture>
        <raw format="png" encoding="base64"></raw>
      </picture>
    </region>
    <region left="0" top="711" width="199" height="24" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">ΔT</e>
          <e type="operand">Pon</e>
          <e type="operand">Rthja</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
