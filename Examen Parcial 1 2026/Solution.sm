          <e type="operand">Vout</e>
          <e type="operand">3.3</e>
          <e type="operand" style="unit">V</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="0" top="6075" width="214" height="24" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">Iin</e>
          <e type="operand">Iout</e>
          <e type="operand">Ignd</e>
          <e type="operator" args="2">+</e>
          <e type="operator" args="2">:</e>
        </input>
        <contract>
          <e type="operand" style="unit">mA</e>
        </contract>
        <result action="numeric">
          <e type="operand">400.7</e>
        </result>
      </math>
    </region>
    <region left="0" top="6093" width="267" height="24" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">P</e>
          <e type="operand">Vin</e>
          <e type="operand">Iin</e>
          <e type="operator" args="2">*</e>
          <e type="operand">Vout</e>
          <e type="operand">Iout</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">-</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">0.6835</e>
          <e type="operand" style="unit">W</e>
          <e type="operator" args="2">*</e>
        </result>
      </math>
    </region>
    <region left="0" top="6120" width="774" height="23" color="#000000" bgColor="#ffff00" fontSize="10">
      <text lang="eng" width="774" fontFamily="Arial" fontSize="10">
        <content>
          <p style="background-color: #ffff00; font-weight: bold;">B. Thermal resistance</p>
        </content>
      </text>
    </region>
    <region left="0" top="6138" width="759" height="38" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-weight: bold;">Estimate the junction-to-ambient thermal resistance for the available copper area. Indicate which curve you used and include units.</p>
        </content>
      </text>
    </region>
    <region left="0" top="6174" width="772" height="49" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p>Using the information about PCB (Two-layer FR-4, 1 oz copper) and the area of copper available to spread heat (\[REGION[e828f07d84534f399e47c52955798737]]\), the Theta JA can be identified as below.</p>
        </content>
        <regions>
          <region id="e828f07d84534f399e47c52955798737" left="669" top="0" width="64" height="33" color="#000000" fontSize="10">
            <math>
              <input>
                <e type="operand">100</e>
                <e type="operand" style="unit">mm</e>
                <e type="operand">2</e>
                <e type="operator" args="2">^</e>
                <e type="operator" args="2">*</e>
              </input>
            </math>
          </region>
        </regions>
      </text>
    </region>
    <region left="0" top="6219" width="86" height="41" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">JA</e>
          <e type="operand">107</e>
          <e type="operand" style="unit">K</e>
          <e type="operand" style="unit">W</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="144" top="6219" width="234" height="146" color="#000000">
      <picture>
        <raw format="png" encoding="base64"></raw>
      </picture>
    </region>
    <region left="0" top="6363" width="600" height="23" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-weight: bold;">Is the regulator's current rating enough to decide whether it is suitable here? Explain briefly.</p>
        </content>
      </text>
    </region>
    <region left="0" top="6381" width="769" height="53" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p>No. The regulator’s current rating alone does not establish that it can continuously supply 400 mA in this design. At that load, it dissipates 0.6835 W, so the junction temperature must be calculated using the PCB’s thermal resistance and the 60 °C ambient temperature.</p>
        </content>
      </text>
    </region>
    <region left="0" top="6435" width="774" height="23" color="#000000" bgColor="#ffff00" fontSize="10">
      <text lang="eng" width="774" fontFamily="Arial" fontSize="10">
        <content>
          <p style="background-color: #ffff00; font-weight: bold;">C. Junction temperature</p>
        </content>
      </text>
    </region>
    <region left="0" top="6462" width="767" height="38" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-weight: bold;">Calculate the junction temperature at the stated load and ambient temperature. Compare it with the operating limit and the required 10 °C margin. </p>
        </content>
      </text>
    </region>
    <region left="0" top="6498" width="177" height="29" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">T.AMAX</e>
          <e type="operand">60</e>
          <e type="operand" style="unit">°C</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">333.15</e>
          <e type="operand" style="unit">K</e>
          <e type="operator" args="2">*</e>
        </result>
      </math>
    </region>
    <region left="0" top="6525" width="233" height="29" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">T.j</e>
          <e type="operand">T.AMAX</e>
          <e type="operand">P</e>
          <e type="operand">JA</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">+</e>
          <e type="operator" args="2">:</e>
        </input>
        <contract>
          <e type="operand" style="unit">°C</e>
        </contract>
        <result action="numeric">
          <e type="operand">133.1345</e>
        </result>
      </math>
    </region>
    <region left="0" top="6552" width="537" height="23" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p>Juntion temperature is higher than the maximum operating junction temperatue (125 °C).</p>
        </content>
      </text>
    </region>
    <region left="0" top="6570" width="722" height="33" color="#000000">
      <picture>
        <raw format="png" encoding="base64"></raw>
      </picture>
    </region>
    <region left="0" top="6615" width="693" height="23" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-weight: bold;">Explain why the absolute maximum temperature and the thermal shutdown temperature are different limits.</p>
        </content>
      </text>
    </region>
    <region left="0" top="6633" width="780" height="38" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p>The maximum junction temperature (150°C) is an stress limit. While the thermal shutdown(160°C) is the temperature at which the protection circuit is designed in order to protect the maximum junction temperature is exceeded.</p>
        </content>
      </text>
    </region>
    <region left="0" top="6669" width="355" height="264" color="#000000">
      <picture>
        <raw format="png" encoding="base64"></raw>
      </picture>
    </region>
    <region left="0" top="6993" width="771" height="23" color="#000000" bgColor="#ffff00" fontSize="10">
      <text lang="eng" width="771" fontFamily="Arial" fontSize="10">
        <content>
          <p style="background-color: #ffff00;">D. Your engineering decision</p>
        </content>
      </text>
    </region>
    <region left="0" top="7020" width="774" height="23" color="#000000" fontSize="10">
      <text lang="eng" width="774" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-weight: bold;">Would you APPROVE or REJECT this design? Justify either answer with your numbers.</p>
        </content>
      </text>
    </region>
    <region left="0" top="7056" width="781" height="53" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p>I would reject the design. At a 60 °C ambient temperature, the regulator dissipates 0.6835 W. With the estimated thermal resistance of 107 °C/W for 100 mm² of 1 oz copper, the junction reaches approximately 133.1 °C. This is 8.1 °C above the 125 °C operating limit and 18.1 °C above the 115 °C design target required by the 10 °C margin.</p>
        </content>
      </text>
    </region>
    <region left="0" top="7119" width="777" height="23" color="#000000" fontSize="10">
      <text lang="eng" width="769" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-weight: bold;">Would increasing the copper area to as much as 500 mm² be enough, keeping 1 oz copper and the same thermal model?</p>
        </content>
      </text>
    </region>
    <region left="0" top="7137" width="770" height="49" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p>No, to meet the margin at the same load and ambient temperature, both PCB and area would need to be changed, the proposal would be 2 oz copper and a \[REGION[4cc97f17e18c43dda6552efb7205a05b]]\ area.</p>
        </content>
        <regions>
          <region id="4cc97f17e18c43dda6552efb7205a05b" left="170" top="15" width="64" height="33" color="#000000" fontSize="10">
            <math>
              <input>
                <e type="operand">400</e>
                <e type="operand" style="unit">mm</e>
                <e type="operand">2</e>
                <e type="operator" args="2">^</e>
                <e type="operator" args="2">*</e>
              </input>
            </math>
          </region>
        </regions>
      </text>
    </region>
    <region left="0" top="7191" width="185" height="29" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">T.jmax</e>
          <e type="operand">115</e>
          <e type="operand" style="unit">°C</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">388.15</e>
          <e type="operand" style="unit">K</e>
          <e type="operator" args="2">*</e>
        </result>
      </math>
    </region>
    <region left="0" top="7209" width="224" height="46" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">JA</e>
          <e type="operand">T.jmax</e>
          <e type="operand">T.AMAX</e>
          <e type="operator" args="2">-</e>
          <e type="operand">P</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">:</e>
        </input>
        <contract>
          <e type="operand" style="unit">K</e>
          <e type="operand" style="unit">W</e>
          <e type="operator" args="2">/</e>
        </contract>
        <result action="numeric">
          <e type="operand">80.4682</e>
        </result>
      </math>
    </region>
    <region left="162" top="7245" width="380" height="236" color="#000000">
      <picture>
        <raw format="png" encoding="base64"></raw>
      </picture>
    </region>
  </regions>
</worksheet>