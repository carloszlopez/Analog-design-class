.inc CoilcraftTemplates.lib

*======================================================================
* SPICE Model generated by Coilcraft
* Coilcraft Part Number : SLR4040-220
* Inductance = 22nH
*======================================================================
* Model Parameters:
*   Valid Frequency Range = 100kHz-1000MHz
*   Ambient Temperature = 25 degC
*   Inductor Frequency Model
*   Use model for Frequency Domain simulations
*======================================================================
.subckt SLR4040-220_freq port1 port2 PARAMS: Cpar=30.19pF Ind=0.022uH
X1 port1 port2 Model1A PARAMS:
+ R1=22.8
+ R2=0.00032
+ C= {Cpar}
+ K1=0.0000185
+ K2=0.00566
+ K3= {Ind}
+ K4=0.000052
+ K5=3.49E-08
.ends SLR4040-220_freq

