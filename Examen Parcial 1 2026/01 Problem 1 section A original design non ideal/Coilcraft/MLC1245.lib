.inc CoilcraftTemplates.lib

*======================================================================
* SPICE Model generated by Coilcraft
* Coilcraft Part Number : MLC1245-152
* Inductance = 1.5uH
*======================================================================
* Model Parameters:
*   Valid Frequency Range = 100kHz-100MHz
*   Ambient Temperature = 25 degC
*   Inductor Frequency Model
*   Use model for Frequency Domain simulations
*======================================================================
.subckt MLC1245-152_freq port1 port2 PARAMS: Cpar=2.84pF Ind=1.5uH
X1 port1 port2 Model1A PARAMS:
+ R1=16
+ R2=0.00408
+ C= {Cpar}
+ K1=0.000001
+ K2=0.079
+ K3= {Ind}
+ K4=0.005
+ K5=0.000007
.ends MLC1245-152_freq

